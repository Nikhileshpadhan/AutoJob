# ========================================================
# AUTOJOB Multi-User SaaS Platform Environment Variables
# ========================================================

# 1. Database Connection (Turso Cloud for production or local SQLite file)
# For Turso Cloud ($0/mo tier):
# DATABASE_URL=libsql://your-db-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-jwt-auth-token
# For Local Development:
DATABASE_URL=file:./data/autojob.db
DATABASE_AUTH_TOKEN=

# 2. Authentication & BYOK Encryption Secrets
# Generate random 32-byte / 64-hex strings:
# e.g., openssl rand -hex 32
JWT_SECRET=super-secret-jwt-signing-key-minimum-32-chars
ENCRYPTION_SECRET=super-secret-32-byte-aes-256-gcm-encryption-key-for-byok

# 3. Optional: GitHub Actions Cloud Dispatcher (for $0 Vercel + GitHub Actions worker)
# When set, clicking "Start Runner" on Vercel dispatches .github/workflows/autojob-worker.yml
GITHUB_REPO=
GITHUB_PAT=

# 4. Optional Local Dev Fallbacks (In SaaS mode, users configure their own keys in /settings)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
ACTIVE_LLM_PROVIDER=gemini
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false
TELEGRAM_API_BASE_URL=https://api.telegram.org

# 5. Browser Automation Defaults
HEADLESS_BROWSER=true
BROWSER_EXECUTABLE_PATH=
CHROMIUM_NO_SANDBOX=false
