# ==========================================
# AUTOJOB Automation Environment Configuration
# ==========================================

# LLM Providers (Free Tier APIs)
# Get a free Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Get a free Groq API key: https://console.groq.com/keys
GROQ_API_KEY=

# Preferred LLM Engine: "gemini" or "groq"
ACTIVE_LLM_PROVIDER=gemini

# Telegram Bot Alert Configuration (Human-in-the-loop CAPTCHA bypass)
# Create a bot via @BotFather on Telegram to obtain the token
TELEGRAM_BOT_TOKEN=
# Send a message to your bot or use @userinfobot to find your numeric Chat ID
TELEGRAM_CHAT_ID=

# Strict Daily Application Quota (Default: 5 applications/day)
DAILY_APPLICATION_CAP=5

# Playwright Browser Automation
HEADLESS_BROWSER=false
BROWSER_USER_DATA_DIR=./data/browser_profile

# Database location
DATABASE_URL=file:./data/autojob.db
