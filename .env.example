# ==========================================
# AUTOJOB Automation Environment Configuration
# ==========================================

# LLM Providers (Free Tier APIs)
# Get a free Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Gemini model (Valid production models: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Get a free Groq API key: https://console.groq.com/keys
GROQ_API_KEY=

# Preferred LLM Engine: "gemini" or "groq"
ACTIVE_LLM_PROVIDER=gemini

# Telegram Bot Alert Configuration (Human-in-the-loop CAPTCHA/OTP verification)
# Create a bot via @BotFather on Telegram to obtain the token
TELEGRAM_BOT_TOKEN=
# Send a message to your bot or use @userinfobot to find your numeric Chat ID
TELEGRAM_CHAT_ID=
# Optional: Set to false to suppress telegram alerts
TELEGRAM_ENABLED=true
# Optional: If your ISP blocks api.telegram.org (common in India), set a reverse proxy (e.g., Cloudflare Worker)
# TELEGRAM_API_BASE_URL=https://your-worker.workers.dev

# Independent Platform Daily Caps (Anti-Ban Pacing)
LINKEDIN_DAILY_CAP=5
INTERNSHALA_DAILY_CAP=5

# Playwright Browser Automation
HEADLESS_BROWSER=false
# Browser executable path (Google Chrome dedicated automation browser)
BROWSER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Only enable in restricted containers with custom seccomp profile
CHROMIUM_NO_SANDBOX=false

# Security & Secret Encryption (Optional - auto-generated if omitted)
# 32-byte hex string used to encrypt API keys at rest in SQLite
# ENCRYPTION_KEY=
# Optional admin secret to protect API routes
# AUTOJOB_ADMIN_SECRET=

# Database location
DATABASE_URL=file:./data/autojob.db
